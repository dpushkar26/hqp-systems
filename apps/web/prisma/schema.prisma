generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  UPI
  CARD
  CASH
}

enum UserRole {
  PLATFORM_ADMIN
  PLATFORM_OPS
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

enum HotelStatus {
  DRAFT
  ASSIGNED
  APPROVED
  LIVE
  SUSPENDED
}

enum InvoiceStatus {
  OPEN
  PENDING_PAYMENT
  PAID
  VOID
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

model Hotel {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  status            HotelStatus    @default(DRAFT)
  gstin             String?
  fssaiNo           String?
  address           String?
  phone             String?
  logoUrl           String?
  gstRateBp         Int            @default(500) // Placeholder pending CA confirmation
  serviceChargeBp   Int            @default(0)
  pricesIncludeTax  Boolean        @default(false)
  upiVpa            String?
  razorpayAccountId String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  deletedAt         DateTime?
  
  customers         Customer[]
  tables            Table[]
  categories        MenuCategory[]
  menuItems         MenuItem[]
  orders            Order[]
  invoices          Invoice[]
  rewardRules       RewardRule[]
  sessions          Session[]
}

model Customer {
  id            String    @id @default(cuid())
  hotelId       String
  phoneNumber   String
  name          String?
  visitCount    Int       @default(0)
  lastVisitDate DateTime?
  consentAt     DateTime?
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  orders        Order[]
  invoices      Invoice[]
  sessions      Session[]

  @@unique([phoneNumber, hotelId])
}

model Table {
  id        String    @id @default(cuid())
  hotelId   String
  name      String
  capacity  Int?
  label     String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  
  hotel     Hotel     @relation(fields: [hotelId], references: [id])
  orders    Order[]
  invoices  Invoice[]
  sessions  Session[]
}

model Session {
  id           String    @id @default(cuid())
  tableId      String
  customerId   String?
  hotelId      String
  otpHash      String?
  otpAttempts  Int       @default(0)
  otpSentAt    DateTime?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  expiresAt    DateTime  @default(dbgenerated("NOW() + interval '4 hours'"))
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  table        Table     @relation(fields: [tableId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  hotel        Hotel     @relation(fields: [hotelId], references: [id])

  @@index([tableId])
  @@index([customerId])
  @@index([hotelId])
}

model MenuCategory {
  id      String     @id @default(cuid())
  hotelId String
  name    String
  
  hotel   Hotel      @relation(fields: [hotelId], references: [id])
  items   MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  hotelId     String
  categoryId  String
  name        String
  priceMinor  Int
  isAvailable Boolean      @default(true)
  imageUrl    String?
  isVeg       Boolean      @default(true)
  description String?
  sortOrder   Int          @default(0)
  taxRateBp   Int?
  deletedAt   DateTime?
  
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId, isAvailable])
  @@index([hotelId, categoryId])
}

model Order {
  id              String        @id @default(cuid())
  hotelId         String
  tableId         String
  customerId      String
  status          OrderStatus   @default(PLACED)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMode     PaymentMode
  notes           String?
  cancelledReason String?
  placedBySessionId String?
  createdAt       DateTime      @default(now())
  invoiceId       String?

  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  table           Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  payments        Payment[]

  @@index([hotelId, status, createdAt])
  @@index([tableId])
  @@index([customerId])
  @@index([invoiceId])
}

model Invoice {
  id                 String        @id @default(cuid())
  hotelId            String
  tableId            String
  customerId         String
  status             InvoiceStatus @default(OPEN)
  invoiceNumber      String?
  subtotalMinor      Int           @default(0)
  discountMinor      Int           @default(0)
  serviceChargeMinor Int           @default(0)
  cgstMinor          Int           @default(0)
  sgstMinor          Int           @default(0)
  igstMinor          Int           @default(0)
  roundOffMinor      Int           @default(0)
  totalMinor         Int           @default(0)
  settledAt          DateTime?
  settledByUserId    String?
  voidReason         String?
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMode        PaymentMode?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  hotel              Hotel         @relation(fields: [hotelId], references: [id])
  table              Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  customer           Customer      @relation(fields: [customerId], references: [id])
  orders             Order[]
  payments           Payment[]

  @@index([hotelId, paymentStatus])
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  menuItemId  String
  quantity    Int
  priceMinor  Int
  nameSnapshot String
  taxRateBp   Int
  status      ItemStatus @default(PENDING)
  
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String?
  invoiceId        String?
  gatewayRef       String?
  gatewayOrderId   String?
  gatewayPaymentId String?       @unique
  idempotencyKey   String        @unique
  amountMinor      Int
  status           PaymentStatus
  
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([gatewayRef])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique
  payload         Json
  processedAt     DateTime @default(now())
}

model RewardRule {
  id                String @id @default(cuid())
  hotelId           String
  visitThreshold    Int
  rewardDescription String
  
  hotel             Hotel  @relation(fields: [hotelId], references: [id])
}

model InvoiceCounter {
  hotelId String
  fy      String
  last    Int

  @@id([hotelId, fy])
}

model AuditLog {
  id        String   @id @default(cuid())
  hotelId   String?
  userId    String?
  action    String
  entity    String
  entityId  String
  meta      Json
  createdAt DateTime @default(now())
}

model NotificationLog {
  id          String   @id @default(cuid())
  hotelId     String
  invoiceId   String?
  channel     String
  status      String
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
}

// --- NextAuth Models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole
  hotelId       String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  
  accounts      Account[]

  @@index([hotelId, role])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OwnerOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

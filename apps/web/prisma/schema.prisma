generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PREPARING
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  UPI
  CARD
  CASH
}

model Hotel {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  customers    Customer[]
  tables       Table[]
  categories   MenuCategory[]
  menuItems    MenuItem[]
  orders       Order[]
  invoices     Invoice[]
  rewardRules  RewardRule[]
  sessions     Session[]
}

model Customer {
  id            String    @id @default(cuid())
  hotelId       String
  phoneNumber   String
  visitCount    Int       @default(0)
  lastVisitDate DateTime?
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  orders        Order[]
  invoices      Invoice[]
  sessions      Session[]

  @@unique([phoneNumber, hotelId])
}

model Table {
  id      String    @id @default(cuid())
  hotelId String
  name    String
  
  hotel   Hotel     @relation(fields: [hotelId], references: [id])
  orders  Order[]
  invoices Invoice[]
  sessions Session[]
}

model Session {
  id           String    @id @default(cuid())
  tableId      String
  customerId   String?
  hotelId      String
  otpCode      String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  table        Table     @relation(fields: [tableId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  hotel        Hotel     @relation(fields: [hotelId], references: [id])

  @@index([tableId])
  @@index([customerId])
}

model MenuCategory {
  id      String     @id @default(cuid())
  hotelId String
  name    String
  
  hotel   Hotel      @relation(fields: [hotelId], references: [id])
  items   MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  hotelId     String
  categoryId  String
  name        String
  price       Float
  isAvailable Boolean      @default(true)
  
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId, isAvailable])
}

model Order {
  id            String        @id @default(cuid())
  hotelId       String
  tableId       String
  customerId    String
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMode   PaymentMode
  createdAt     DateTime      @default(now())
  invoiceId     String?

  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  table         Table         @relation(fields: [tableId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([hotelId, status, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  hotelId       String
  tableId       String
  customerId    String
  totalAmount   Float
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMode   PaymentMode?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  table         Table         @relation(fields: [tableId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  orders        Order[]
  payments      Payment[]

  @@index([hotelId, paymentStatus])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float    // Price snapshot at the time of order
  
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String?
  invoiceId  String?
  gatewayRef String?
  amount     Float
  status     PaymentStatus
  
  order      Order?        @relation(fields: [orderId], references: [id])
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])

  @@index([gatewayRef])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique
  payload         Json
  processedAt     DateTime @default(now())
}

model RewardRule {
  id                String @id @default(cuid())
  hotelId           String
  visitThreshold    Int
  rewardDescription String
  
  hotel             Hotel  @relation(fields: [hotelId], references: [id])
}

// --- NextAuth Models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("OWNER")
  
  accounts      Account[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OwnerOTP {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PLACED
  PREPARING
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMode {
  UPI
  CARD
  CASH
}

model Hotel {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  customers    Customer[]
  tables       Table[]
  categories   MenuCategory[]
  menuItems    MenuItem[]
  orders       Order[]
  rewardRules  RewardRule[]
  sessions     Session[]
}

model Customer {
  id            String    @id @default(cuid())
  hotelId       String
  phoneNumber   String
  visitCount    Int       @default(0)
  lastVisitDate DateTime?
  
  hotel         Hotel     @relation(fields: [hotelId], references: [id])
  orders        Order[]
  sessions      Session[]

  @@unique([phoneNumber, hotelId])
}

model Table {
  id      String    @id @default(cuid())
  hotelId String
  name    String
  
  hotel   Hotel     @relation(fields: [hotelId], references: [id])
  orders  Order[]
  sessions Session[]
}

model Session {
  id           String    @id @default(cuid())
  tableId      String
  customerId   String?
  hotelId      String
  otpCode      String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  table        Table     @relation(fields: [tableId], references: [id])
  customer     Customer? @relation(fields: [customerId], references: [id])
  hotel        Hotel     @relation(fields: [hotelId], references: [id])

  @@index([tableId])
  @@index([customerId])
}

model MenuCategory {
  id      String     @id @default(cuid())
  hotelId String
  name    String
  
  hotel   Hotel      @relation(fields: [hotelId], references: [id])
  items   MenuItem[]
}

model MenuItem {
  id          String       @id @default(cuid())
  hotelId     String
  categoryId  String
  name        String
  price       Float
  isAvailable Boolean      @default(true)
  
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId, isAvailable])
}

model Order {
  id            String        @id @default(cuid())
  hotelId       String
  tableId       String
  customerId    String
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMode   PaymentMode
  createdAt     DateTime      @default(now())
  
  hotel         Hotel         @relation(fields: [hotelId], references: [id])
  table         Table         @relation(fields: [tableId], references: [id])
  customer      Customer      @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]

  @@index([hotelId, status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Float    // Price snapshot at the time of order
  
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String
  gatewayRef String?
  amount     Float
  status     PaymentStatus
  
  order      Order         @relation(fields: [orderId], references: [id])

  @@index([gatewayRef])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        String
  providerEventId String   @unique
  payload         Json
  processedAt     DateTime @default(now())
}

model RewardRule {
  id                String @id @default(cuid())
  hotelId           String
  visitThreshold    Int
  rewardDescription String
  
  hotel             Hotel  @relation(fields: [hotelId], references: [id])
}

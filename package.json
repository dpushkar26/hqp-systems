{
  "name": "hqsp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test:backend:setup": "scripts/test-env.sh && docker-compose -f infra/docker-compose.test.yml up -d && pnpm prisma migrate deploy && pnpm build",
    "test:backend": "pnpm test:backend:migrations && pnpm test:backend:security && pnpm test:backend:flows",
    "test:backend:migrations": "NODE_ENV=test vitest run tests/backend/migrations",
    "test:backend:security": "NODE_ENV=test vitest run tests/backend/security",
    "test:backend:flows": "NODE_ENV=test vitest run tests/backend/flows",
    "test:backend:teardown": "docker-compose -f infra/docker-compose.test.yml down -v"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.5",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
